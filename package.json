{
  "name": "@satora/striker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "regtest": "node scripts/regtest.mjs",
    "spike": "node --import tsx --test --test-concurrency=1 spike/*.test.ts",
    "test": "npm test --workspaces --if-present",
    "e2e": "node --import tsx --test --test-concurrency=1 packages/core/test/*.regtest.test.ts apps/striker/test/*.regtest.test.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.5.6",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.2.0",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
